# ─────────────────────────────────────────────────────────────────────────────
# EatBit — Next.js Frontend Environment Variables
# Copy this file to:
#   .env.local       → for local development
#   .env.production  → for production (Vercel / your deploy platform)
# ─────────────────────────────────────────────────────────────────────────────

# URL of the FastAPI backend
# Local dev  → http://localhost:8000
# Production → https://api.eatbit.in
NEXT_PUBLIC_API_URL=http://localhost:8000

# Razorpay public key (safe to expose — starts with rzp_test_ for test mode)
# Get from: https://dashboard.razorpay.com → Settings → API Keys
# Use rzp_test_* for local, rzp_live_* for production
NEXT_PUBLIC_RAZORPAY_KEY_ID=rzp_test_XXXXXXXXXXXXXXXX

# Google OAuth Client ID (safe to expose)
# Get from: https://console.cloud.google.com → APIs & Services → Credentials
NEXT_PUBLIC_GOOGLE_CLIENT_ID=YOUR_GOOGLE_CLIENT_ID.apps.googleusercontent.com
